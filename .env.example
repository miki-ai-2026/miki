# Copy to .env.local and fill in. Never commit .env.local or real values.

# Supabase project URL and publishable key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. SERVER ONLY: bypasses row level security.
# Never prefix with NEXT_PUBLIC_ and never import it in client code.
SUPABASE_SECRET_KEY=
