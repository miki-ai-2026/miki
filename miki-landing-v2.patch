+
+/* Concept demo + early-access form */
+.demo-shell { display: grid; gap: 16px; max-width: 520px; margin-top: 32px; }
+.demo-moments { display: flex; flex-wrap: wrap; gap: 8px; }
+.chip { min-height: 44px; padding: 10px 16px; border: 1px solid var(--whisper-border, rgba(24,24,27,.14)); border-radius: 999px; background: #fff; color: var(--ink); font: inherit; font-size: 14px; font-weight: 500; cursor: pointer; transition: background 180ms, color 180ms; }
+.chip[aria-pressed="true"] { background: var(--ink); color: #fff; }
+.chip:focus-visible, .chat-actions button:focus-visible, .join-form input:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
+.chat { display: flex; flex-direction: column; border: 1px solid rgba(24,24,27,.1); border-radius: 24px; background: #fff; overflow: hidden; }
+.chat-head { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid rgba(24,24,27,.08); background: #f7f6fb; }
+.chat-head img { border-radius: 50%; object-fit: cover; }
+.chat-head strong, .chat-head span { display: block; line-height: 1.3; }
+.chat-head span { color: #5b5b64; font-size: 12px; }
+.chat-log { display: flex; flex-direction: column; gap: 10px; min-height: 260px; padding: 18px; }
+.msg { max-width: 85%; padding: 10px 14px; border-radius: 18px; font-size: 15px; line-height: 1.5; animation: msg-in 240ms ease-out; }
+.msg-miki { align-self: flex-start; background: #f1effa; color: var(--ink); border-bottom-left-radius: 6px; }
+.msg-user { align-self: flex-end; background: var(--ink); color: #fff; border-bottom-right-radius: 6px; }
+@keyframes msg-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
+.chat-actions { display: flex; flex-wrap: wrap; gap: 8px; min-height: 68px; padding: 12px 18px 18px; border-top: 1px solid rgba(24,24,27,.08); }
+.chat-actions button { min-height: 44px; padding: 10px 16px; border: 1px solid var(--ink); border-radius: 999px; background: transparent; color: var(--ink); font: inherit; font-size: 14px; font-weight: 500; cursor: pointer; }
+.chat-actions button:hover { background: var(--lemon-signal); }
+.join-form { display: grid; gap: 16px; max-width: 520px; margin-top: 32px; }
+.join-form label { display: grid; gap: 6px; font-size: 14px; font-weight: 500; }
+.join-form input { min-height: 48px; padding: 12px 16px; border: 1px solid rgba(24,24,27,.2); border-radius: 14px; background: #fff; color: var(--ink); font: inherit; font-size: 16px; }
+.join-form input[aria-invalid="true"] { border-color: #b42318; }
+.join-form .primary-button { justify-self: start; cursor: pointer; }
+.form-note { min-height: 1.5em; margin: 0; color: #5b5b64; font-size: 14px; }
+@media (prefers-reduced-motion: reduce) { .msg { animation: none; } }
